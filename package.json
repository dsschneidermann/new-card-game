{
  "name": "new-card-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A 2D worldmap card-and-combat game (Phaser 3 + Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "art": "npx oxipng -o max assets/* --strip safe"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "oxipng": "^1.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
